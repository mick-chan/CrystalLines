<?xml version="1.0" encoding="utf-8"?>
<manifest 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    package="com.michaelctchan.colourlines" 
    android:versionName="@string/ver_name"
>
    <application android:icon="@drawable/icon" android:label="@string/app_name" android:debuggable="true">
        <!-- AdMobActivity definition -->
        <activity 
            android:name="com.admob.android.ads.AdMobActivity"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboard|keyboardHidden">
        </activity>
        
        <!-- The application's publisher ID assigned by AdMob -->
        <meta-data android:value="a14d38248691306" android:name="ADMOB_PUBLISHER_ID" />
        <meta-data android:value="true" android:name="ADMOB_ALLOW_LOCATION_FOR_ADS"/>
        
        <!-- Track Market installs -->
        <receiver 
            android:name="com.admob.android.ads.analytics.InstallReceiver"
            android:exported="true">
            <intent-filter>
              <action android:name="com.android.vending.INSTALL_REFERRER" />
            </intent-filter>
        </receiver>
	            
        <activity android:name=".ColourLines"
            android:label="@string/app_name"
            android:launchMode="singleTop" android:screenOrientation="portrait" android:configChanges="keyboardHidden|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity 
            android:name=".view.SettingsScreen"
            android:label="@string/edit_settings"
            android:launchMode="singleTop" android:screenOrientation="portrait" android:configChanges="keyboardHidden|orientation">
        </activity>
    </application>
    <uses-sdk android:minSdkVersion="4" />
	
    <!-- AdMob SDK requires Internet permission -->    
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
</manifest> 

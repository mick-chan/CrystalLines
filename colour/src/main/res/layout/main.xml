<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
	android:layout_width="fill_parent"
	android:layout_height="fill_parent"
>
	<LinearLayout
	    xmlns:android="http://schemas.android.com/apk/res/android" 
		android:orientation="vertical"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_alignParentTop="true"
		
	>
		<LinearLayout
		    android:id="@+id/panel"
		    android:orientation="horizontal"
		    android:layout_width="fill_parent"
		    android:layout_height="fill_parent"
		    android:layout_weight="1"
		>
		    <TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
		        android:id="@+id/table1"
		        android:layout_width="fill_parent"
		        android:layout_height="fill_parent"
		        android:stretchColumns="1"
		        android:layout_weight="1"
	            android:gravity="center"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
	            android:layout_marginTop="16dp"
	            android:layout_marginBottom="16dp"
		    >
		        <TableRow
		        >
			    <TextView android:id="@+id/next_text"
			        android:layout_width="fill_parent"
			        android:layout_height="fill_parent"
	                android:layout_marginRight="5dp"	        
			        android:text="@string/next_text"
			        android:textColor="#B0FF85"
		            android:gravity="center"
	                android:layout_weight="1"
			    />	    
			    <TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
			        android:id="@+id/nextcolours"
			        android:layout_width="wrap_content"
			        android:layout_height="fill_parent"     
			        android:layout_margin="1dp"
			        android:padding="1dp"
			        android:verticalSpacing="1dp"
			        android:horizontalSpacing="1dp"
			        android:gravity="center"
			        android:layout_weight="1"
			    >
			    </TableLayout>       		    
	            <TextView android:id="@+id/next_text"
	                android:layout_width="fill_parent"
	                android:layout_height="fill_parent"
	                android:text=" "
	                android:gravity="center"
	                android:layout_weight="1"
	            />      	        
		        </TableRow>        
		    </TableLayout>        
		    <TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
		        android:id="@+id/table2"
		        android:layout_width="fill_parent"
		        android:layout_height="fill_parent"
		        android:stretchColumns="1"
		        android:layout_weight="1"
	            android:gravity="center_vertical|center"
		    >
		        <TableRow>        
		        <TextView android:id="@+id/score_text"
		            android:layout_width="fill_parent"
		            android:layout_height="fill_parent"
	                android:layout_marginRight="5dp"
	                android:padding="1dp"
		            android:text="@string/score_text"
		            android:textColor="#B0FF85"
		            android:gravity="center_vertical|center"
		            
		        />
		        <EditText android:id="@+id/score_value"   
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:layout_marginRight="5dp"
                            android:textColor="#B0FF85"	            
                            android:cursorVisible="false"
                            android:editable="false"	            
	                    android:gravity="center_vertical|right"
                            android:background="@drawable/score_rounded_edges"
                            android:typeface="monospace"                                       
		        />
		        </TableRow>
		    </TableLayout>
		</LinearLayout>      
		          
	    <TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
	        android:id="@+id/playingfield"
	        android:layout_width="wrap_content"
	        android:layout_height="wrap_content"
	        android:background="#B0FF85"        
	        android:layout_gravity="center_horizontal"
	        android:layout_weight=".15"
	    >       
	    </TableLayout>
	
	</LinearLayout>

</RelativeLayout>  
 
